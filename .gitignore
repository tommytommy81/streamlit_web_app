# Ignore everything in specific folders but keep the folders themselves
# (Use this pattern if you want to track empty folders)
# downloads/*
# !downloads/.gitkeep
# data/*
# !data/.gitkeep

# Keep specific files (examples)
!README.md
!*.py
!*.ipynb
!*.md
!*.txt
!*.yml
!*.yaml
!*.json
!requirements.txt
!setup_environment.sh
!activate_env.sh